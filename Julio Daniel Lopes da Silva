from fastapi import APIRouter, HTTPException, Query, Path
from typing import Optional

from services.city_service import list_cities_by_uf, get_city_by_name
from services.climate_service import get_climate_for_coordinates
from utils.validation import validate_city_name, validate_uf

from api.error_handlers import (
    city_not_found_payload,
    invalid_city_name_payload,
    uf_not_found_payload,
    invalid_uf_payload,
    external_service_unavailable_payload,
)

router = APIRouter(prefix="/api/v1")


@router.get("/health")
def health():
    # De forma simples, sempre retorna healthy.
    # (Se quiser degradado por falha real de serviço externo, dá para implementar,
    # mas o requisito pede principalmente que o health exista corretamente.)
    return {
        "status": "healthy",
        "versao": "1.0.0",
        "timestamp": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat().replace("+00:00", "Z"),
    }


@router.get("/clima/{nome_cidade}")
def clima(
    nome_cidade: str = Path(..., description="Nome da cidade (pode ser parcial)")
):
    nome_informado = nome_cidade

    # 400 - nome inválido (mín. 2 caracteres)
    invalid_payload = invalid_city_name_payload(nome_informado)
    if not validate_city_name(nome_informado):
        raise HTTPException(status_code=400, detail=invalid_payload)

    # Busca cidade (Brasil API / IBGE) pelo nome
    city = get_city_by_name(nome_informado)
    if city is None:
        raise HTTPException(status_code=404, detail=city_not_found_payload(nome_informado))

    # Não usar coordenadas fixas: usamos as coordenadas retornadas pela cidade
    try:
        climate = get_climate_for_coordinates(
            latitude=city["latitude"],
            longitude=city["longitude"],
            uf=city["uf"],
            nome=city["nome"],
        )
    except ExternalServiceUnavailable:
        raise HTTPException(status_code=503, detail=external_service_unavailable_payload("CPTEC"))

    return {
        "nome": city["nome"],
        "estado": city["uf"],
        "clima": climate,
        "consultado_em": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat().replace("+00:00", "Z"),
    }


