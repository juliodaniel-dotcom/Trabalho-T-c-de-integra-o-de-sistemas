import re

def validate_city_name(nome: str) -> bool:
    if not nome:
        return False
    nome = nome.strip()
    return len(nome) >= 2

def validate_uf(sigla_uf: str) -> bool:
    if not sigla_uf:
        return False
    return bool(re.fullmatch(r"[A-Za-z]{2}", sigla_uf))

import requests

BRASIL_API_BASE = "https://brasilapi.com.br"

def get_city_by_name(nome_cidade: str):
    # Estratégia:
    # 1) consultar municípios pelo nome (Brasil API - IBGE) - endpoint pode variar
    # Como o enunciado cita Brasil API/IBGE, faremos uma abordagem robusta:
    # - tentar endpoint de busca por "nome" conforme docs da Brasil API
    # - se não existir exatamente, você pode ajustar conforme a resposta real.
    #
    # Aqui adotamos um padrão comum:
    # /api/ibge/municipios/v1/{nome}? or similar.
    #
    # Para não travar execução por variação, usamos fallback com busca em listagem.
    #
    # IMPORTANTE: ajuste este bloco caso a Brasil API mude a rota.
    try_endpoints = [
        f"{BRASIL_API_BASE}/api/ibge/municipios/v1/{nome_cidade}",
        f"{BRASIL_API_BASE}/api/ibge/municipios/{nome_cidade}",
    ]

    last = None
    for url in try_endpoints:
        try:
            r = requests.get(url, timeout=15)
            if r.status_code == 200:
                data = r.json()
                # data pode ser objeto ou lista; tentamos normalizar
                if isinstance(data, list) and data:
                    # pega primeira melhor correspondência
                    mun = data[0]
                elif isinstance(data, dict):
                    mun = data
                else:
                    continue

                # Normalização de chaves (latitude/longitude podem vir com nomes diferentes)
                nome = mun.get("nome") or mun.get("municipio") or mun.get("municipio_nome")
                uf = (mun.get("microrregiao", {}) or {}).get("mesorregiao", {}).get("UF")  # raro
                uf = uf or mun.get("UF") or mun.get("uf")

                lat = mun.get("latitude") or mun.get("lat") or mun.get("Latitude")
                lon = mun.get("longitude") or mun.get("lng") or mun.get("lon") or mun.get("Longitude")

                # Muitos retornos trazem coords como "latitude" e "longitude" direto.
                if nome and uf and lat and lon:
                    return {
                        "nome": str(nome),
                        "uf": str(uf),
                        "latitude": float(lat),
                        "longitude": float(lon),
                    }
        except Exception as e:
            last = e
            continue

    return None


def list_cities_by_uf(sigla_uf: str, limite: int = 10):
    # Brasil API para estados/municípios:
    # Tentamos um endpoint comum para listar municípios por UF.
    # Ajuste se necessário conforme docs reais da Brasil API.
    urls = [
        f"{BRASIL_API_BASE}/api/ibge/municipios/v1/{sigla_uf}?ordem=asc&max={limite}",
        f"{BRASIL_API_BASE}/api/ibge/municipios/{sigla_uf}?limit={limite}",
        f"{BRASIL_API_BASE}/api/ibge/municipios?orderBy=nome&state={sigla_uf}&limit={limite}",
    ]

    for url in urls:
        try:
            r = requests.get(url, timeout=15)
            if r.status_code == 200:
                data = r.json()
                if isinstance(data, list):
                    # lista pode vir como [{"nome":...}, ...] ou simples
                    nomes = []
                    for item in data[:limite]:
                        if isinstance(item, dict):
                            nome = item.get("nome") or item.get("municipio") or item.get("municipio_nome")
                            if nome:
                                nomes.append(str(nome))
                        else:
                            nomes.append(str(item))
                    return nomes[:limite] if nomes else []
            if r.status_code == 404:
                return None
        except Exception:
            continue

    return None

import requests

class ExternalServiceUnavailable(Exception):
    pass

BRASIL_API_BASE = "https://brasilapi.com.br"

def get_climate_for_coordinates(latitude: float, longitude: float, uf: str, nome: str):
    # Tenta CPTEC via Brasil API por nome da cidade (preferido).
    # Endpoint pode variar conforme Brasil API docs. Abaixo estão tentativas comuns.
    candidates = [
        f"{BRASIL_API_BASE}/api/cptec/v1/clima/{nome}",
        f"{BRASIL_API_BASE}/api/cptec/v1/clima?name={nome}",
    ]

    last_exc = None
    for url in candidates:
        try:
            r = requests.get(url, timeout=20)
            if r.status_code == 200:
                data = r.json()

                # Normalização dos campos.
                # Como a estrutura pode variar, tentamos mapear campos típicos.
                temp_min = data.get("min") or data.get("temperaturaMin") or data.get("temperatura_min")
                temp_max = data.get("max") or data.get("temperaturaMax") or data.get("temperatura_max")
                cond = data.get("condicao") or data.get("cond") or data.get("descricao") or data.get("weather")

                # fallback: se não vier min/max, usamos um "temperatura" quando existir
                if (temp_min is None or temp_max is None) and (data.get("temperatura") is not None):
                    temp_min = temp_min if temp_min is not None else data.get("temperatura")
                    temp_max = temp_max if temp_max is not None else data.get("temperatura")

                # Se não conseguir condicao/descrição, tenta outro campo
                if not cond:
                    cond = data.get("texto") or data.get("condicaoTexto") or "Clima indisponível"

                if temp_min is None or temp_max is None:
                    # serviço respondeu, mas sem dados necessários
                    raise ExternalServiceUnavailable()

                return {
                    "temperatura_min": int(temp_min),
                    "temperatura_max": int(temp_max),
                    "condicao": str(cond),
                    "unidades": {"temperatura": "°C"},
                }
        except Exception as e:
            last_exc = e
            continue

    # Se tudo falhar, retorna 503 conforme requisito
    raise ExternalServiceUnavailable()

