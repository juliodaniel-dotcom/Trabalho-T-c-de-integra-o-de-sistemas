@router.get("/cidades/{sigla_uf}")
def cidades_por_estado(
    sigla_uf: str = Path(..., description="Sigla do estado (2 caracteres)"),
    limite: int = Query(10, ge=1, le=100, description="Quantidade máxima de cidades (1-100)"),
):
    sigla_informada = sigla_uf.upper()

    # 400 - UF inválida
    if not validate_uf(sigla_informada):
        raise HTTPException(status_code=400, detail=invalid_uf_payload(sigla_informada))

    cities = list_cities_by_uf(sigla_informada, limite=limite)
    if cities is None:
        raise HTTPException(status_code=404, detail=uf_not_found_payload(sigla_informada))

    return {
        "uf": sigla_informada,
        "quantidade_retornada": len(cities),
        "cidades": [{"nome": c} for c in cities],
        "consultado_em": __import__("datetime").datetime.now(__import__("datetime").timezone.utc).isoformat().replace("+00:00", "Z"),
    }

